    private static void ResizeStack(FlowLayoutPanel root)
    {
        var width = Math.Max(360, root.ClientSize.Width - root.Padding.Horizontal - SystemInformation.VerticalScrollBarWidth - 4);
        foreach (Control control in root.Controls) control.Width = width;
    }

    private T AddStack<T>(FlowLayoutPanel root, T control, int height, int bottomMargin = 14) where T : Control
    {
        control.Height = height; control.Margin = new Padding(0, 0, 0, bottomMargin); root.Controls.Add(control); ResizeStack(root); return control;
    }

