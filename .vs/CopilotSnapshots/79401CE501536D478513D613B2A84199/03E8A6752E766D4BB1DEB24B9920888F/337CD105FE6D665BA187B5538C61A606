    private static void ResizeNav(FlowLayoutPanel nav)
    {
        var width = Math.Max(170, nav.ClientSize.Width - nav.Padding.Horizontal - SystemInformation.VerticalScrollBarWidth - 4);
        foreach (Control control in nav.Controls)
        {
            control.Width = width;
            if (control is Panel panel && panel.Controls.Count > 0) panel.Width = width;
        }
    }

