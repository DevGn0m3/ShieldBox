    private void SetScreen(string title, string subtitle, Control control)
    {
        // Si estamos fuera del hilo de UI, re-enviar la llamada al hilo de UI.
        if (this.InvokeRequired)
        {
            this.BeginInvoke((Action)(() => SetScreen(title, subtitle, control)));
            return;
        }

        // Protecciones mínimas: evitar NullReferenceException si los controles del diseñador
        // aún no se han inicializado. No cambia la lógica funcional cuando los
        // controles están presentes.
        if (_pageTitle != null) _pageTitle.Text = title;
        if (_pageSubtitle != null) _pageSubtitle.Text = subtitle;

        if (_content == null)
        {
            // _content ausente: no podemos actualizar la vista; registrar y salir
            System.Diagnostics.Trace.TraceWarning("SetScreen: _content es null, omitiendo cambio de pantalla para '{0}'", title);
            return;
        }

        _content.Controls.Clear();
        control.Dock = DockStyle.Fill;
        _content.Controls.Add(control);
        UpdateBadge();
    }

    private FlowLayoutPanel Root()
    {
        var root = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.TopDown, WrapContents = false, AutoScroll = true, BackColor = UiKit.Background, Padding = new Padding(0), Margin = Padding.Empty };
        root.Resize += (_, _) => ResizeStack(root);
